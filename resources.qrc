<RCC>
    <qresource prefix="/">
        <!-- alias, чтобы qrc:/css/style.css, qrc:/js/app.js, qrc:/js/pdf.js
             совпадали со ссылками в webenginehost.cpp / frontend/index.html -->
        <file alias="index.html">frontend/index.html</file>
        <file alias="css/style.css">frontend/css/style.css</file>
        <file alias="js/app.js">frontend/js/app.js</file>
        <file alias="js/pdf.js">frontend/js/pdf.js</file>
        <file alias="js/renderer.js">frontend/js/renderer.js</file>
        <!-- task-13: перенос цепочек формул на строки (зеркало mathsplit.cpp) -->
        <file alias="js/mathsplit.js">frontend/js/mathsplit.js</file>
        <file alias="styles.css">resources/styles.css</file>
        <!-- task-20: иконка окна/taskbar (app.setWindowIcon, main.cpp).
             Для exe (Проводник) — отдельно icon.rc -> icon.ico (WIN32). -->
        <file alias="icon.png">icon-148-148.png</file>
        <!-- task-16b: MathJax 3.2.2 локально (в бинарнике, без CDN) — теперь
             через ГЕНЕРИРУЕМОЕ mathjax-embedded.qrc (см. CMakeLists.txt):
             scripts/embed_mathjax_fonts.py встраивает все 22 woff-шрифта
             ПРЯМО В JS как data: URIs — Chromium на Windows не пропускает
             кросс-оригинную загрузку шрифтов со схемы qrc: (CORS-политика,
             qrc не в whitelist), а data: — да; без встраивания формулы
             рендерятся системным фолбэк-шрифтом (битые начертания).
             Старые mathjax-записи удалены из этого qrc: rcc не терпит
             дубликата prefix+alias из двух .qrc-файлов. -->
    </qresource>
</RCC>
